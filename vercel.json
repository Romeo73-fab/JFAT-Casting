{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/candidates/:id", "destination": "/api/candidates?id=:id" },
    { "source": "/api/candidates", "destination": "/api/candidates" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
